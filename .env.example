# Base URL of the KINETIC Flask API. No trailing slash.
# MUST be https:// — see the cross-origin cookie auth note below.
#   local:      https://localhost:5000
#   production: https://backend.example.vercel.app
NEXT_PUBLIC_API_BASE_URL=https://localhost:5000
API_SECRET_KEY=your-secret-key

# ---------------------------------------------------------------------------
# Cross-origin cookie auth (IMPORTANT) — same model in local AND production
# ---------------------------------------------------------------------------
# The frontend and backend are on DIFFERENT sites (e.g. frontend.vercel.app vs
# backend.vercel.app), so the browser calls the backend directly cross-site.
# For the browser to store and resend the HttpOnly JWT cookies on cross-site
# requests, the setup must be, in BOTH environments:
#
#   - Served over HTTPS on both sides. Locally: `npm run dev` runs Next with
#     --experimental-https (https://localhost:3000), and the Flask API must be
#     reachable over https too (https://localhost:5000). Plain http WILL NOT
#     work — a `Secure` cookie is never sent over http, and `SameSite=None`
#     requires `Secure`.
#
#   - Backend sets its cookies with:  SameSite=None; Secure
#     (identical flag in local and prod — do not vary it by environment).
#
#   - Backend CORS must send:
#       Access-Control-Allow-Credentials: true
#       Access-Control-Allow-Origin: <this app's exact origin>   (NOT "*")
#         local:      https://localhost:3000
#         production: https://frontend.example.vercel.app
#       Access-Control-Allow-Headers: Content-Type, X-CSRF-TOKEN
#
# The frontend already sends every request with credentials included and echoes
# the CSRF token in the X-CSRF-TOKEN header; the above is the backend-side
# configuration required for it to work.

# A known admin account that exists in the Playwright test database.
# Registration only ever creates `customer` accounts, so the admin journeys
# need pre-existing admin credentials.
PW_ADMIN_EMAIL=admin@example.com
PW_ADMIN_PASSWORD=password123

# Payment flow mode:
#   stub - intercept POST /payments and return a canned redirect_url (use this
#          until the Midtrans return URL is configured).
#   real - hit the real backend /payments; the Midtrans *navigation* is still
#          intercepted so the browser never leaves the app.
PW_PAYMENTS_MODE=stub

# Optional: override the app URL Playwright drives (defaults to
# http://localhost:3000).
# PW_BASE_URL=http://localhost:3000
